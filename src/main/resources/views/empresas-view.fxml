<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tracker.presentacion.controllers.EmpresasController">
   <padding>
      <Insets bottom="24.0" left="32.0" right="32.0" top="8.0" />
   </padding>
   <Label text="Empresas">
      <font>
         <Font name="System Bold" size="26.0" />
      </font>
   </Label>
   <HBox alignment="CENTER_LEFT" spacing="10.0">
      <TextField fx:id="txtBuscar" prefWidth="260.0" promptText="Buscar empresa" />
      <Region HBox.hgrow="ALWAYS" />
      <Button mnemonicParsing="false" onAction="#nuevaEmpresa" text="Agregar empresa" />
   </HBox>
   <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12;" VBox.vgrow="ALWAYS">
      <padding>
         <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
      </padding>
      <Label style="-fx-text-fill: #0F766E;" text="Todas las empresas">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Label>
      <TableView fx:id="tablaEmpresas" prefHeight="340.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
            <TableColumn fx:id="colUbicacion" prefWidth="180.0" text="Ubicación" />
            <TableColumn fx:id="colCandidaturas" prefWidth="170.0" text="Candidaturas asociadas" />
            <TableColumn fx:id="colContactos" prefWidth="160.0" text="Contactos asociados" />
            <TableColumn fx:id="colAcciones" prefWidth="200.0" sortable="false" text="" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;">
         <padding>
            <Insets bottom="4.0" left="4.0" right="4.0" top="12.0" />
         </padding>
         <Label fx:id="lblResumen" maxWidth="Infinity" style="-fx-text-fill: #64748B;" HBox.hgrow="ALWAYS" />
         <Pagination fx:id="paginacion" maxPageIndicatorCount="10" />
      </HBox>
   </VBox>
</VBox>
