<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>


<VBox alignment="CENTER" spacing="24.0" style="-fx-background-color: #EEF1F4;" xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.tracker.controllers.LoginController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <ImageView fitHeight="40.0" preserveRatio="true">
        <image>
            <Image url="@../images/logo.png"/>
        </image>
    </ImageView>

    <VBox maxWidth="420.0" spacing="16.0"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16;">
        <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
        </padding>
        <Label text="Iniciar sesión">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
        </Label>
        <VBox spacing="6.0">
            <Label text="Correo electrónico"/>
            <TextField fx:id="txtCorreo" promptText="Ingrese su correo electrónico"/>
        </VBox>
        <VBox spacing="6.0">
            <Label text="Contraseña"/>
            <PasswordField fx:id="txtContrasena" promptText="Ingrese su contraseña"/>
        </VBox>
        <Label alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308"
               style="-fx-text-fill: #0F766E; -fx-font-size: 12;" text="¿Olvidó su contraseña?"/>
        <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#iniciarSesion"
                style="-fx-background-color: #0F766E; -fx-text-fill: white; -fx-background-radius: 10;"
                text="Iniciar sesión">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Button>
        <Separator/>
        <HBox alignment="CENTER" spacing="4.0">
            <Label text="¿No tiene una cuenta?"/>
            <Label style="-fx-text-fill: #0F766E;" text="Regístrese">
                <font>
                    <Font name="System Bold" size="12.0"/>
                </font>
            </Label>
        </HBox>
    </VBox>
</VBox>
